# Stream Deck service for the Corsair Galleon 100 SD (https://github.com/NLMP-DDHS/galleon-deck).
# Tied to the graphical session: it launches apps and reads window focus.
# If it stops, the keyboard falls back to its own numpad mode.

[Unit]
Description=Galleon 100 SD Stream Deck
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
# Include ~/.local/bin: AppImages and user-installed tools often live there.
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/.local/bin/galleon-deck
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical-session.target
